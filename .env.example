# ---- Providers -------------------------------------------------------------
# Anthropic is the only required provider. Everything else is optional; the
# gateway registers a provider only if its key is present, and the UIs render
# whatever is available. Run `python -m ai_core.probe` to see current status.

ANTHROPIC_API_KEY=

# Optional: OpenAI (GPT models)
# OPENAI_API_KEY=

# Optional: OpenRouter — one key for GPT + open models (Llama / Qwen / Kimi).
# Cheapest way to add a second and third provider leg.
# OPENROUTER_API_KEY=

# Optional: local models via Ollama (no key; set the base URL if non-default)
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Defaults --------------------------------------------------------------
AI_CORE_DEFAULT_MODEL=claude-opus-5
AI_CORE_DEFAULT_EFFORT=high
AI_CORE_USAGE_DB=./data/usage.db
AI_CORE_LOG_LEVEL=INFO
